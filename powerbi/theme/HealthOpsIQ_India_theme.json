{
  "name": "HealthOpsIQ India",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"],
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#898781",
  "background": "#fcfcfb",
  "backgroundLight": "#f9f9f7",
  "backgroundNeutral": "#e1e0d9",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#6da7ec",
  "minimum": "#cde2fb",
  "null": "#c3c2b7",
  "hyperlink": "#256abf",
  "visitedHyperlink": "#4a3aa7",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514e" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0b0b0b" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "gridlineStyle": "solid", "gridlineThickness": 1, "labelColor": { "solid": { "color": "#898781" } }, "fontSize": 9 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#52514e" } }, "fontSize": 9 }],
        "legend": [{ "show": true, "position": "Top", "labelColor": { "solid": { "color": "#52514e" } }, "fontSize": 9 }],
        "labels": [{ "color": { "solid": { "color": "#52514e" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }]
      }
    }
  }
}
